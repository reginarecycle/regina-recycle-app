{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**/*", "node_modules/.prisma/**/*", "node_modules/@prisma/client/**/*", "prisma/**/*"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/pickup-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/refresh-tip",
      "schedule": "0 0 * * *"
    }
  ]
}
