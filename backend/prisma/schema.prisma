generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId               String                  @id @default(uuid())
  role                 Role                    @default(CUSTOMER)
  name                 String
  email                String                  @unique
  phoneNumber          String?
  emailVerified        Boolean                 @default(false)
  status               UserStatus              @default(ACTIVE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
  password             String
  agreedToTerms        Boolean                 @default(false)
  agreedToTermsAt      DateTime?
  emailOtp             String?
  emailOtpExpiresAt    DateTime?
  passwordOtp          String?
  passwordOtpExpiresAt DateTime?
  addresses            Address[]
  collectorPricings    CollectorPricing[]
  collectorProfile     CollectorProfile?
  customerDOB          CustomerDOB?
  notificationPrefs    NotificationPreference?
  notifications        Notification[]
  paymentMethod        PaymentMethod[]
  pickupsCollected     Pickup[]                @relation("collector")
  pickupsRequested     Pickup[]                @relation("requester")
  topUpRequests        TopUpRequest[]
  walletTransactions   WalletTransaction[]
  wallet               Wallet?
  withdrawRequests     WithdrawRequest[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model CustomerDOB {
  id        String   @id @default(uuid())
  userId    String   @unique
  dob       DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("customer_dobs")
}

model CollectorProfile {
  collectorProfileId   String   @id @default(uuid())
  userId               String   @unique
  licenseId            String   @unique
  serviceFee           Decimal  @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  bulkIncentiveEnabled Boolean  @default(false)
  bulkThreshold        Int      @default(100)
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([licenseId])
  @@map("collector_profiles")
}

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  emailPickupReminder  Boolean  @default(true)
  emailAccountActivity Boolean  @default(true)
  emailMarketing       Boolean  @default(false)
  inAppPickupReminder  Boolean  @default(true)
  inAppAlerts          Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notification_preferences")
}

model Address {
  addressId  String   @id @default(uuid())
  userId     String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String
  latitude   Float?
  longitude  Float?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  pickups    Pickup[]

  @@unique([userId, line1, postalCode])
  @@index([userId])
  @@map("addresses")
}

model CollectorPricing {
  collectorPricingId String        @id @default(uuid())
  collectorUserId    String
  materialId         String
  status             PricingStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  basePrice          Decimal       @db.Decimal(14, 2)
  bulkPrice          Decimal?      @db.Decimal(14, 2)
  collector          User          @relation(fields: [collectorUserId], references: [userId], onDelete: Cascade)
  material           materials     @relation(fields: [materialId], references: [materialId], onDelete: Cascade)

  @@unique([collectorUserId, materialId])
  @@index([collectorUserId])
  @@index([materialId])
  @@index([status])
  @@map("collector_pricing")
}

model Pickup {
  pickupId         String           @id @default(uuid())
  requesterUserId  String?
  collectorUserId  String?
  scheduledAt      DateTime
  addressId        String?
  status           PickupStatus     @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  actualEarning    Decimal?         @db.Decimal(14, 2)
  estimatedEarning Decimal?         @db.Decimal(14, 2)
  items            PickupItem[]
  snapshots        PickupSnapshot[]
  address          Address?         @relation(fields: [addressId], references: [addressId])
  collector        User?            @relation("collector", fields: [collectorUserId], references: [userId])
  requester        User?            @relation("requester", fields: [requesterUserId], references: [userId])

  @@index([requesterUserId])
  @@index([collectorUserId])
  @@index([status])
  @@index([scheduledAt])
  @@map("pickups")
}

model PickupItem {
  pickupId   String
  materialId String
  quantity   Int
  material   materials @relation(fields: [materialId], references: [materialId], onDelete: Cascade)
  pickup     Pickup    @relation(fields: [pickupId], references: [pickupId], onDelete: Cascade)

  @@id([pickupId, materialId])
  @@index([pickupId])
  @@index([materialId])
  @@map("pickup_items")
}

model PickupSnapshot {
  snapshotId    String    @id @default(uuid())
  pickupId      String
  capturedAt    DateTime  @default(now())
  basePrice     Decimal   @db.Decimal(14, 2)
  bulkPrice     Decimal?  @db.Decimal(14, 2)
  bulkThreshold Int?
  materialId    String
  priceUsed     Decimal   @db.Decimal(14, 2)
  quantity      Int
  material      materials @relation(fields: [materialId], references: [materialId])
  pickup        Pickup    @relation(fields: [pickupId], references: [pickupId], onDelete: Cascade)

  @@index([pickupId])
  @@index([materialId])
  @@map("pickup_snapshots")
}

model Wallet {
  walletId     String              @id @default(uuid())
  userId       String              @unique
  balance      Decimal             @default(0.00) @db.Decimal(14, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [userId])

  @@map("wallets")
}

model WalletTransaction {
  transactionId String   @id @default(uuid())
  walletId      String
  userId        String?
  createdAt     DateTime @default(now())
  type          TxType
  status        TxStatus @default(PENDING)
  description   String?
  amount        Decimal  @db.Decimal(14, 2)
  referenceType String?
  referenceId   String?
  user          User?    @relation(fields: [userId], references: [userId])
  wallet        Wallet   @relation(fields: [walletId], references: [walletId], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model TopUpRequest {
  topUpId         String         @id @default(uuid())
  userId          String?
  paymentMethodId String?
  amount          Decimal        @db.Decimal(14, 2)
  status          TxStatus       @default(PENDING)
  requestedAt     DateTime       @default(now())
  processedAt     DateTime?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [paymentMethodId])
  user            User?          @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@map("topup_requests")
}

model PaymentMethod {
  paymentMethodId String            @id @default(uuid())
  userId          String
  cardLast4       String?
  cardBrand       String?
  expMonth        Int?
  expYear         Int?
  isDefault       Boolean           @default(false)
  createdAt       DateTime          @default(now())
  mobileProvider  String?
  phoneNumber     String?
  type            PaymentMethodType
  user            User              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  topUpRequests   TopUpRequest[]

  @@index([userId])
  @@index([type])
  @@map("payment_methods")
}

model WithdrawRequest {
  withdrawId       String    @id @default(uuid())
  userId           String?
  interacEmail     String
  securityQuestion String?
  amount           Decimal   @db.Decimal(14, 2)
  status           TxStatus  @default(PENDING)
  requestedAt      DateTime  @default(now())
  processedAt      DateTime?
  securityAnswer   String?
  user             User?     @relation(fields: [userId], references: [userId])

  @@index([userId])
  @@index([status])
  @@map("withdraw_requests")
}

model Notification {
  notificationId String           @id @default(uuid())
  createdAt      DateTime         @default(now())
  isRead         Boolean          @default(false)
  title          String
  type           NotificationType
  userId         String
  message        String
  user           User             @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, type])
  @@index([createdAt])
  @@map("notifications")
}

model Tip {
  tipId     String    @id @default(uuid())
  content   String    @unique
  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([active])
  @@map("tips")
}

model Pickup {
  id        Int      @id @default(autoincrement())
  date      DateTime
  status    String
  createdAt DateTime @default(now())
  userId    String
  User      User     @relation(fields: [userId], references: [id])
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  phone     String?
  createdAt DateTime @default(now())
  Pickup    Pickup[]
  Wallet    Wallet?
}

model Wallet {
  id        Int      @id @default(autoincrement())
  balance   Float    @default(0)
  userId    String   @unique
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model materials {
  materialId        String             @id
  name              String             @unique
  type              String
  photoUrl          String?
  co2Saved          Float?
  waterSaved        Float?
  createdAt         DateTime           @default(now())
  description       String?
  collectorPricings CollectorPricing[]
  pickupItems       PickupItem[]
  pickupSnapshots   PickupSnapshot[]

  @@index([type])
}

/// ENUMS
enum Role {
  CUSTOMER
  COLLECTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  EMAIL_PICKUP_REMINDER
  IN_APP_PICKUP_REMINDER
  ACCOUNT_ACTIVITY
  MARKETING
  ALERT
}

enum PickupStatus {
  PENDING
  IN_PROGRESS
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum TxType {
  CREDIT
  DEBIT
}

enum TxStatus {
  PENDING
  FAILED
  COMPLETED
}

enum PaymentMethodType {
  CARD
  MOBILE_PAYMENT
}

enum PricingStatus {
  ACTIVE
  INACTIVE
}
